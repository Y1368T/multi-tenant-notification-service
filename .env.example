# ===========================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ===========================================
# Copy this file and rename it to .env.{environment}
# Supported environments: local, development, staging, uat, production
#
# Usage:
#   docker-compose -f docker-compose.{environment}.yml --env-file .env.{environment} up -d
#
# Examples:
#   docker-compose -f docker-compose.local.yml --env-file .env.local up -d
#   docker-compose -f docker-compose.production.yml --env-file .env.production up -d
#
# CI/CD SECRETS REPLACEMENT:
# --------------------------
# Values marked with CICD_SECRET_* are placeholders that should be replaced
# by your CI/CD pipeline using environment variables or secrets management.
#
# Example GitLab CI/CD replacement:
#   sed -i "s/CICD_SECRET_POSTGRES_PASSWORD/$POSTGRES_PASSWORD/g" .env.{env}
#
# Example GitHub Actions:
#   envsubst < .env.{env}.template > .env.{env}

# Application Settings
APP_ENV=local
HOST=0.0.0.0
PORT=8000
PRODUCTION=False

# PostgreSQL Configuration
# Use a dedicated app user (postgres), never the default superuser 'postgres'.
# After suspected compromise: rotate password, audit objects (e.g. \df in psql), consider recreating DB.
POSTGRES_USER=notification_svc
POSTGRES_PASSWORD=wbhg05G332X6rmyfhM2Z
POSTGRES_DB=qena_notification_service_db
POSTGRES_HOST=your-db-host
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5432

# Database URLs (internal container networking)
DATABASE_URL=postgresql+asyncpg://notification_svc:wbhg05G332X6rmyfhM2Z@your-db-host:5432/qena_notification_service_db
DATABASE_URL_SYNC=postgresql://notification_svc:wbhg05G332X6rmyfhM2Z@your-db-host:5432/qena_notification_service_db

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=CICD_SECRET_RABBITMQ_PASSWORD
RABBITMQ_HOST=your-rabbitmq-host
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:CICD_SECRET_RABBITMQ_PASSWORD@your-rabbitmq-host:5672/

# Redis Configuration
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=CICD_SECRET_REDIS_PASSWORD
REDIS_EXTERNAL_PORT=6379
REDIS_URL=redis://:CICD_SECRET_REDIS_PASSWORD@your-redis-host:6379/0

# Redis Insight
RITRUSTEDORIGINS=http://localhost:8001,http://127.0.0.1:8001
REDIS_HOSTS=local:redis:6379

# AfroMessage SMS Provider
AFROMESSAGE_BASEURL=https://api.afromessage.com/api
AFROMESSAGE_APIKEY=CICD_SECRET_AFROMESSAGE_APIKEY
AFROMESSAGE_SENDER=AfroMessage
AFROMESSAGE_FROM=CICD_SECRET_AFROMESSAGE_FROM

# Admin Configuration
ADMIN_API_KEY=CICD_SECRET_ADMIN_API_KEY

# Docker Registry (for non-local environments)
DOCKER_REGISTRY=registry.kifiya.et/qena_baas
IMAGE_TAG=latest

# The bot token is stored per-tenant in the DB, not in .env
# TELEGRAM_BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx