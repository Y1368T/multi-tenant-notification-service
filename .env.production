# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# This file is used by docker-compose.production.yml
# Usage: docker-compose -f docker-compose.production.yml --env-file .env.production up -d
#
# NOTE: Sensitive values (marked with CICD_SECRET_*) should be overridden
# via CI/CD environment variables or secrets management.

# Application Settings
APP_ENV=production
HOST=0.0.0.0
PORT=8000
PRODUCTION=True

# PostgreSQL Configuration (dedicated user, not default postgres)
POSTGRES_USER=notification_svc
POSTGRES_PASSWORD=CICD_SECRET_POSTGRES_PASSWORD
POSTGRES_DB=qena_notification_service_db
POSTGRES_HOST=production-db-host
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433

# Database URLs
DATABASE_URL=postgresql+asyncpg://notification_svc:CICD_SECRET_POSTGRES_PASSWORD@production-db-host:5432/qena_notification_service_db
DATABASE_URL_SYNC=postgresql://notification_svc:CICD_SECRET_POSTGRES_PASSWORD@production-db-host:5432/qena_notification_service_db

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=prod_user
RABBITMQ_DEFAULT_PASS=CICD_SECRET_RABBITMQ_PASSWORD
RABBITMQ_HOST=production-rabbitmq-host
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://prod_user:CICD_SECRET_RABBITMQ_PASSWORD@production-rabbitmq-host:5672/%2F

# Redis Configuration
REDIS_HOST=production-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=CICD_SECRET_REDIS_PASSWORD
REDIS_URL=redis://:CICD_SECRET_REDIS_PASSWORD@production-redis-host:6379/0

# Redis Insight
RITRUSTEDORIGINS=http://localhost:8001,http://127.0.0.1:8001
REDIS_HOSTS=local:redis:6379

# AfroMessage SMS Provider
AFROMESSAGE_BASEURL=https://api.afromessage.com/api
AFROMESSAGE_APIKEY=CICD_SECRET_AFROMESSAGE_APIKEY
AFROMESSAGE_SENDER=AfroMessage
AFROMESSAGE_FROM=CICD_SECRET_AFROMESSAGE_FROM

# Admin Configuration
ADMIN_API_KEY=CICD_SECRET_ADMIN_API_KEY

# Docker Registry
DOCKER_REGISTRY=registry.kifiya.et/qena_baas
IMAGE_TAG=latest
