# ===========================================
# STAGING ENVIRONMENT CONFIGURATION
# ===========================================
# This file is used by docker-compose.staging.yml
# Usage: docker-compose -f docker-compose.staging.yml --env-file .env.staging up -d
#
# NOTE: Sensitive values (marked with CICD_SECRET_*) should be overridden
# via CI/CD environment variables or secrets management.

# Application Settings
APP_ENV=staging
HOST=0.0.0.0
PORT=8000
PRODUCTION=False

# PostgreSQL Configuration (dedicated user, not default postgres)
POSTGRES_USER=notification_svc
POSTGRES_PASSWORD=CICD_SECRET_POSTGRES_PASSWORD
POSTGRES_DB=qena_notification_service_db
POSTGRES_HOST=staging-db-host
POSTGRES_PORT=5432

# Database URLs
DATABASE_URL=postgresql+asyncpg://notification_svc:CICD_SECRET_POSTGRES_PASSWORD@staging-db-host:5432/qena_notification_service_db
DATABASE_URL_SYNC=postgresql://notification_svc:CICD_SECRET_POSTGRES_PASSWORD@staging-db-host:5432/qena_notification_service_db

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=staging_user
RABBITMQ_DEFAULT_PASS=CICD_SECRET_RABBITMQ_PASSWORD
RABBITMQ_HOST=staging-rabbitmq-host
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://staging_user:CICD_SECRET_RABBITMQ_PASSWORD@staging-rabbitmq-host:5672/%2F

# Redis Configuration
REDIS_HOST=staging-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=CICD_SECRET_REDIS_PASSWORD
REDIS_URL=redis://:CICD_SECRET_REDIS_PASSWORD@staging-redis-host:6379

# Redis Insight
RITRUSTEDORIGINS=http://localhost:8001,http://127.0.0.1:8001

# AfroMessage SMS Provider
AFROMESSAGE_BASEURL=https://api.afromessage.com/api
AFROMESSAGE_APIKEY=CICD_SECRET_AFROMESSAGE_APIKEY
AFROMESSAGE_SENDER=AfroMessage
AFROMESSAGE_FROM=CICD_SECRET_AFROMESSAGE_FROM

# Admin Configuration
ADMIN_API_KEY=CICD_SECRET_ADMIN_API_KEY

# Docker Registry
DOCKER_REGISTRY=registry.kifiya.et/qena_baas
IMAGE_TAG=staging
